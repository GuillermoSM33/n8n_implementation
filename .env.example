# Copia este archivo a .env y llena los valores. .env NO se sube a git.
# Aquí solo va configuración del contenedor; los secretos de las integraciones
# (service_role de Supabase, token de Meta, secreto del webhook) se capturan
# como credenciales dentro de n8n, no en este archivo.

# --- n8n ---
# Genera ambos con: openssl rand -hex 32
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# URL pública con la que n8n anuncia sus webhooks (la del túnel), con / final.
N8N_PUBLIC_URL=http://localhost:5678/

# --- Supabase (no secreto) ---
H4U_SUPABASE_URL=https://<project-ref>.supabase.co
# Llave pública (anon o publishable): Project Settings → API Keys. La usa el triaje
# para validar el token del operador. No es secreta (el frontend también la tiene).
H4U_SUPABASE_ANON_KEY=

# --- Solo para scripts/correr_migraciones.sh (SÍ es secreta; .env no se sube) ---
# Connect → Session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Triaje con IA (la API key va en la credencial de n8n "H4U · API key de Gemini") ---
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# --- Escalamiento ---
# WhatsApp del operador de guardia (E.164 sin +, ej. 5219981234567). Debe estar
# verificado en el número de prueba de Meta.
H4U_OPERATOR_PHONE=
H4U_UNASSIGNED_MINUTES=30
H4U_UNACKNOWLEDGED_MINUTES=30

# --- WhatsApp Cloud API (no secreto; el token va en la credencial de n8n) ---
WHATSAPP_API_BASE=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
# template: plantilla aprobada (obligatorio para iniciar conversación).
# text: texto libre (solo si el destinatario escribió al número en las últimas 24 h).
WHATSAPP_MESSAGE_MODE=template
# hello_world viene aprobada en todas las cuentas y no lleva parámetros.
# Cuando Meta apruebe "aviso_incidencia" (ver docs/), cambia a:
#   WHATSAPP_TEMPLATE_NAME=aviso_incidencia
#   WHATSAPP_TEMPLATE_LANG=es_MX
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
