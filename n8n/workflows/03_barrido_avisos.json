{
  "id": "H4uBarridoAvisos",
  "name": "H4U · Barrido: escalamientos y reintentos",
  "active": false,
  "nodes": [
    {
      "id": "s-cron",
      "name": "Cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "s-enqueue",
      "name": "Encolar escalamientos y pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.H4U_SUPABASE_URL }}/rest/v1/rpc/enqueue_escalations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_unassigned_minutes: Number($env.H4U_UNASSIGNED_MINUTES || 30), p_unacknowledged_minutes: Number($env.H4U_UNACKNOWLEDGED_MINUTES || 30) }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "H4uSupabaseSrv01",
          "name": "H4U · Supabase service_role"
        }
      }
    },
    {
      "id": "s-if",
      "name": "¿Hay avisos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.outbox_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "s-call",
      "name": "Procesar aviso",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "H4uProcesarAviso"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "outbox_id": "={{ $json.outbox_id }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "outbox_id",
              "displayName": "outbox_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "number",
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Cada minuto": {
      "main": [
        [
          {
            "node": "Encolar escalamientos y pendientes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encolar escalamientos y pendientes": {
      "main": [
        [
          {
            "node": "¿Hay avisos?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hay avisos?": {
      "main": [
        [
          {
            "node": "Procesar aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "timezone": "America/Mexico_City"
  },
  "pinData": {},
  "tags": []
}
